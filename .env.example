# Copy to .env.local and fill in. Never commit .env.local.
# See docs/nextjs-sanity-oauth-guide.md for where each value comes from.

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# ID of the OAuth client registered for your Sanity organization
SANITY_OAUTH_CLIENT_ID=
# OAuth client secret. Shown once when the client is created. Keep it out of code, tickets and chat.
SANITY_OAUTH_CLIENT_SECRET=
# Encrypts the session and OAuth transaction cookies.
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
SANITY_OAUTH_AUTHORIZE_URL=https://api.sanity.io/v1/auth/oauth/authorize
SANITY_OAUTH_TOKEN_URL=https://api.sanity.io/v1/auth/oauth/token
SANITY_OAUTH_REVOKE_URL=https://api.sanity.io/v1/auth/oauth/revoke
# Must match a redirect URI registered on the OAuth client exactly
SANITY_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/sanity/callback
# Refresh when the access token has less than this many seconds left (default 1 day)
SANITY_TOKEN_REFRESH_WINDOW_SECONDS=86400

# --- Public (shipped to the browser) ---
# Project ID from sanity.io/manage (shown on the project page)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# ID of the organization that owns the project (sanity.io/manage, organization settings)
NEXT_PUBLIC_SANITY_ORG_ID=
