# Copy to .env.local and fill in. Never commit .env.local.

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SANITY_OAUTH_CLIENT_ID=oc-cb4d9e5706da
# Owner adds this directly. Do not paste it into code, tickets or chat.
SANITY_OAUTH_CLIENT_SECRET=
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
SANITY_OAUTH_AUTHORIZE_URL=https://api.sanity.io/v1/auth/oauth/authorize
SANITY_OAUTH_TOKEN_URL=https://api.sanity.io/v1/auth/oauth/token
SANITY_OAUTH_REVOKE_URL=https://api.sanity.io/v1/auth/oauth/revoke
# Must match a registered redirect URI exactly
SANITY_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/sanity/callback
# Refresh when the access token has less than this many seconds left (default 1 day)
SANITY_TOKEN_REFRESH_WINDOW_SECONDS=86400

# Phase 1 only: a personal token for the proof page. Remove once OAuth works.
SANITY_DEV_TOKEN=

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=sin73gke
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_ORG_ID=owdwn9v45
